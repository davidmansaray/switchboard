{
  "name": "@switchboard/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./seed": "./src/seed.ts",
    "./reset": "./src/reset.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts"
  },
  "dependencies": {
    "@switchboard/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.7",
    "dotenv": "17.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
