# Switchboard environment. Copy to .env.local (gitignored) and fill in.

# --- Database (local: Homebrew Postgres 17; production: self-hosted Postgres) ---
# Pooled/regular connection used by Drizzle (app schema).
DATABASE_URL=postgres://localhost:5432/switchboard_showcase_dev
# Direct/session connection for LISTEN/NOTIFY (the web app's live updates). Never a transaction pooler.
DATABASE_URL_DIRECT=postgres://localhost:5432/switchboard_showcase_dev
# Postgres pool size per process; size the pool for your own database.
# DB_POOL_MAX=10
# Mastra storage (PostgresStore + PgVector, schema "mastra"). Same database.
MASTRA_DATABASE_URL=postgres://localhost:5432/switchboard_showcase_dev
# Integration tests run against this database (reset per suite).
TEST_DATABASE_URL=postgres://localhost:5432/switchboard_showcase_test

# --- Models (Mastra model router strings) ---
ANTHROPIC_API_KEY=
# Optional. Set when the Anthropic key is NOT scoped to one workspace: every request then carries
# the header `anthropic-workspace-id: <this value>` (the desk model, the observer model and
# recording all go through Mastra's router, which builds the AI SDK provider with the header).
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5-5
FAST_MODEL=anthropic/claude-haiku-5-5
EMBEDDING_MODEL=openai/text-embedding-3-small
# scripted – deterministic offline desk policy (default; no keys needed)
# live     – call AGENT_MODEL through the router (needs ANTHROPIC_API_KEY)
# record   – call the model and write every response to scenarios/recordings/ (see RECORD_SOURCE)
# replay   – serve responses from scenarios/recordings/, falling back to the scripted desk on a miss
LLM_MODE=scripted
# What `record` wraps: live (default; needs the key) or scripted (exercises the pipeline offline).
RECORD_SOURCE=scripted
# Where recordings live (default: <repo>/scenarios/recordings).
RECORDINGS_DIR=
# Per-step latency of the scripted desk (ms): makes runs demo-paced and races visible.
SCRIPTED_LATENCY_MS=400
# Staff field edits within this window collapse into one queued message.
EDIT_DEBOUNCE_MS=1500
# off (default) | live: embed evidence chunks for vector search (not wired yet; full-text + trigram search is used)
EMBEDDINGS_MODE=off

# --- Orchestration ---
# harness (Mastra signals/schedules/durable agents) | app (app-owned event loop fallback)
SIGNAL_BACKEND=harness

# --- Services ---
# Agent service (Mastra server). Port 4223 in the showcase (see docs/deployment.md).
MASTRA_SERVER_URL=http://localhost:4223
PORT=4223
APP_URL=http://localhost:3223
# Signs the demo "sign in as" cookie and authenticates web → agent internal routes.
SESSION_SECRET=
INTERNAL_API_TOKEN=
# Allows the simulator's "Crash worker" (and beat 6) to really SIGKILL the agent process. Only
# turn this on where a supervisor restarts the agent (pnpm dev does; systemd Restart=always does).
ALLOW_CRASH_ENDPOINT=false
# Allows the simulator's Reset (truncates and re-seeds app + mastra tables in place).
ALLOW_SCENARIO_RESET=false
# Log the agent's boot phases with timings.
SWITCHBOARD_BOOT_TRACE=false

# Local showcase ports; scripts/setup-local.mjs also sets random demo secrets.
WEB_PORT=3223
AGENT_PORT=4223
